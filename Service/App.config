<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>

	<appSettings>
		<add key="W_threshold" value="30" />
		<add key="L_threshold" value="0.7" />
		<add key="AverageDeviation" value="0.25" />
		<add key="StoragePath" value="ServiceStorage" />
	</appSettings>

	<system.serviceModel>
		<services>
			<service name="Service.DroneTelemetryService">
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:4002" />
					</baseAddresses>
				</host>

				<endpoint
				  address="DroneTelemetryService"
				  binding="netTcpBinding"
				  bindingConfiguration="TcpStreamingBinding"
				  contract="Common.IDroneTelemetryService" />
			</service>
		</services>

		<bindings>
			<netTcpBinding>
				<binding name="TcpStreamingBinding"
						 transferMode="Streamed"
						 maxReceivedMessageSize="10485760"
						 openTimeout="00:01:00"
						 closeTimeout="00:01:00"
						 sendTimeout="00:05:00"
						 receiveTimeout="00:10:00">
					<security mode="None" />
				</binding>
			</netTcpBinding>
		</bindings>
	</system.serviceModel>
</configuration>